include CMakeLists.txt
recursive-include cmake *.cmake
recursive-include src *.cpp *.hpp *.h CMakeLists.txt
recursive-include tests *.cpp *.hpp *.f90 CMakeLists.txt
recursive-include fortran *.f90 CMakeLists.txt
recursive-include third_party/autodiff *.hpp *.h *.cmake *.in CMakeLists.txt
include third_party/autodiff/LICENSE
recursive-include disper26 *.py *.pyi *.csv py.typed

include README.md LICENSE NOTICE CITATION.cff AGENTS.md .gitmodules
recursive-include docs *.md
recursive-include examples *.py *.md
recursive-include tests *.py *.json *.csv *.txt
recursive-include paper *.py *.cpp *.hpp *.h *.cmake *.in *.md *.json *.npz *.csv *.txt CMakeLists.txt
prune paper/results
prune paper/Fig
prune build
prune paper/reference_sources/*/build
global-exclude *.so *.o *.pyc
recursive-include paper/reference_sources LICENSE BUILD
